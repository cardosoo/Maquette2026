[Unit]
Description=Maquettes API (FastAPI / uvicorn)
Documentation=http://localhost:8300/docs
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=olivier
Group=olivier
WorkingDirectory=/home/olivier/Devel/Maquette2026
ExecStart=/home/olivier/Devel/Maquette2026/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8300 --root-path /maquette
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT

# Renforcement
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
